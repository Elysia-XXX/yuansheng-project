# ============================
# 通用忽略
# ============================

# 操作系统生成文件
.DS_Store
Thumbs.db
*.tmp

# 编辑器/IDE 配置（保留 .project 等 Eclipse 文件，按需调整）
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ============================
# 大文件 / 压缩包（防止误提交）
# ============================
*.zip
*.tar
*.gz
*.rar
*.7z
*.iso
*.bin
*.exe
*.dmg
*.pkg
*.msi
*.deb
*.rpm

# ============================
# 敏感配置 / 环境变量
# ============================
# 注意：backend/.env.example 是"安全模板"（不含真实密钥），保持被跟踪；
# 真实密钥只写进 backend/.env（已被上面规则忽略）。已跟踪文件不受忽略规则影响，
# 因此如果某文件曾被提交过，必须先 git rm --cached 才能真正生效。
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local

# ============================
# Python 后端
# ============================
# 虚拟环境
backend/.venv/
backend/venv/
backend/env/
backend/ENV/
backend/env.bak/
backend/venv.bak/

# Python 编译缓存
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# 日志文件
*.log
*.err.log
*.out.log
backend/*.log
backend/server.stderr.log
backend/server.stdout.log
backend/analyze_*.log
backend/analyze_*.err.log

# 数据库 / 本地数据
*.db
*.sqlite
*.sqlite3

# 临时文件
*.tmp
*.temp
backend/*.tmp

# ============================
# Node.js / Vue 前端
# ============================
frontend/node_modules/
frontend/.npm
frontend/.yarn
frontend/.pnp
frontend/.pnp.js
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# 前端构建产物
frontend/build/
frontend/out/
frontend/.cache

# ============================
# 测试 / 覆盖率
# ============================
.coverage
htmlcov/
.pytest_cache/
.tox/
*.cover
*.py,cover
frontend/coverage/
frontend/.nyc_output/

# ============================
# 其他项目特定目录
# ============================
# 如果你的 .zcode 是临时脚本目录，可以忽略
.zcode/
# docs/ 通常保留，但如果有临时生成的文件可单独忽略

# ============================
# 避免忽略重要的项目配置文件
# ============================
# 不忽略 .project、.actionScriptProperties、.flexProperties（按用户需求）
# 也不忽略 package.json、requirements.txt 等

# ============================
# 防止误提交大文件（再次强调）
# ============================
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.iso
*.bin

# ============================
# WorkBuddy 本地产物（不入库）
# .genie / .wbapp* 为应用发布标记；.workbuddy/ 为本地工作区数据
# 仅忽略，不删除；这些文件保留在本地供工具使用
# ============================
.workbuddy/
*.genie
.wbapp*