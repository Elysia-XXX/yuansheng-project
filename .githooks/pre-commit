#!/bin/sh
# 提交前密钥泄露扫描（无外部依赖）
# 扫描暂存区新增行中的常见密钥模式，命中则拦截提交。
# 误报放行：git commit --no-verify

PATTERNS='sk-[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{30,}|gho_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY|AIza[0-9A-Za-z_-]{35}'

# 1) 拦截 .env 实体文件被提交
ENV_FILES=$(git diff --cached --name-only | grep -E "(^|/)\.env$" )
if [ -n "$ENV_FILES" ]; then
  echo ""
  echo "[BLOCKED] 以下 .env 文件被加入了暂存区（真实密钥不允许入库）："
  echo "$ENV_FILES"
  echo "如确属误报：git commit --no-verify"
  exit 1
fi

# 2) 扫描暂存区新增行中的密钥模式
HITS=$(git diff --cached -U0 | grep -E "^\+" | grep -E "$PATTERNS")
if [ -n "$HITS" ]; then
  echo ""
  echo "[BLOCKED] 暂存区检测到疑似密钥/凭据，提交已拦截："
  echo "$HITS"
  echo ""
  echo "处理方式：把密钥移到 .env（已被 .gitignore 忽略），或确认误报后 git commit --no-verify"
  exit 1
fi

exit 0
