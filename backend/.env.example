# 复制本文件为 .env 后按需修改
# 本机默认 127.0.0.1（IPv4，trust 免密）；localhost 可能解析为 ::1 而要求密码
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
# 本机默认无密码；如有密码请填写
DB_PASSWORD=
DB_NAME=postgres
CATALOG_DB_NAME=product_catalog

# Xiaomi MiMo（密钥仅填写在本地 .env，勿提交到 Git）
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# 对话 Agent：默认复用上面的 MiMo 配置，也可接入其他支持 Chat Completions tools 的服务
# 生产模式 false，演示模式 true（不连接数据库、不调用模型，只展示虚构数据）
AGENT_DEMO_MODE=false
# 留空以下三项时，请删除对应行以自动继承 MIMO 配置
# AGENT_API_KEY=
# AGENT_BASE_URL=https://api.xiaomimimo.com/v1
# AGENT_MODEL=mimo-v2.5-pro
