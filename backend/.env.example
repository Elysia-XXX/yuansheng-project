# 复制本文件为 .env 后按需修改
# 本机默认 127.0.0.1（IPv4，trust 免密）；localhost 可能解析为 ::1 而要求密码
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
# 本机默认无密码；如有密码请填写
DB_PASSWORD=
DB_NAME=postgres
CATALOG_DB_NAME=product_catalog

# Xiaomi MiMo（密钥仅填写在本地 .env，勿提交到 Git）
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
